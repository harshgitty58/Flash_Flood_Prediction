# Parquet (large ML dataset) - comment out if you want it tracked
# data/processed/final/*.parquet
data/external/*
# ...except the derived label set (small CSV/JSON, needed by tests/test_labels.py); raw PDFs/HTML and EM-DAT exports stay out (licences)
!data/external/labels/
data/external/labels/*
!data/external/labels/*.csv
!data/external/labels/labels_summary.json
data/external/labels/emdat_*

# Large, regenerable outputs (rebuilt by scripts/run_all.py); GitHub rejects files > 100 MB
results/impact/buildings.geojson
results/conformal/cp_replay_predictions.csv
results/shap/shap_top_drivers.csv
results/warning_levels/replay_warning_levels.csv
node_modules/
web/dist/
*.log

